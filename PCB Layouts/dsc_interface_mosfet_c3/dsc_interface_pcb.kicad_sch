	(text "J1: 3-position 5.08 mm screw terminal, 22-16 AWG alarm wire"
		(exclude_from_sim no)
		(at 30.48 36.83 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0f30340c-d426-46e0-9b71-6134398cfa9a")
	)
	(text "Notes:\ni: resistors r1,r2 connection can be omitted as the internal gpio will be set as input_pullup\nii: q1,q2  can be substituted for other low power N-channel Mosfets. Be careful of pin locations as some are reversed such as with the bs170.\niii: the yellow and green lines from the panel already have builtin 10k pullup resistors so none are needed on the interface.\niv: j3 provides 12v output from the panel that can be used by an external step down to USB converter for powering the ESP.  \n  Powering the esp directly on the 5v pin is not recommended as it will conflict with the usb input if a cable is plugged in.\n"
		(exclude_from_sim no)
		(at 94.996 114.046 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4bfafb47-8780-4ebc-b7b9-0cfbb39f1bb5")
	)
	(text "DSC interface - Mosfet version"
		(exclude_from_sim no)
		(at 85.852 21.336 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "71ada5df-3f86-4eac-8e75-cf56bb6621b9")
	)
	(text "Black = GND"
