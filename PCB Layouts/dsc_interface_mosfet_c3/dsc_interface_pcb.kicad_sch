		(uuid "7ea94eff-388a-4d40-b861-711bb0894452")
	)
	(text "ESP32C3 supermini pins:\n  dscclockpin: \"6\"\n  dscreadpin: \"5\"\n  dscwritepin: \"5\"\n\nSeeed XIAO ESP32C3 pins:\n  dscclockpin: \"3\"\n  dscreadpin: \"2\"\n  dscwritepin: \"2\"\n\nESP32S3 supermini pins:\n  dscclockpin: \"44\"\n  dscreadpin: \"43\"\n  dscwritepin: \"43\"\n\nSeeed XIAO ESP32S3 pins:\n  dscclockpin: \"2\"\n  dscreadpin: \"1\"\n  dscwritepin: \"1\"\n\n"
		(exclude_from_sim no)
		(at 194.31 63.5 0)
